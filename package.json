{
  "name": "blog-of-TorchMar",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm run build:blog && pnpm run build:academic",
    "build:academic": "node academic/scripts/validate-config.js && node scripts/build-academic.mjs",
    "build:blog": "valaxy build --ssg --output dist/blog",
    "build:spa": "valaxy build --output dist/blog",
    "build:ssg": "pnpm run build:blog",
    "dev": "valaxy",
    "dev:academic": "vite academic",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.5.0",
    "react-pdf": "11.0.0",
    "valaxy": "0.23.5",
    "valaxy-addon-twikoo": "^0.0.3",
    "valaxy-theme-yun": "0.23.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "ajv": "8.20.0",
    "typescript": "^5.8.3",
    "vite": "7.1.9"
  }
}
